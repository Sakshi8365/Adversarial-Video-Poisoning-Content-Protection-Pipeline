# Copy this to .env and fill with real values (DO NOT commit .env)
# Example values shown for local development only

# Database connection used by the API and workers
DATABASE_URL=postgresql+asyncpg://postgres:changeme@postgres:5432/protection

# Redis URL for job queue and caching
REDIS_URL=redis://redis:6379/0

# Postgres image defaults (used by docker-compose postgres service)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_DB=protection

# Other optional overrides
#SENTRY_DSN=
#SECRET_KEY=
